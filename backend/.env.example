# Backend Configuration
PORT=4270
NODE_ENV=development

# Redis (for job queue)
# Set SKIP_REDIS=true to run without Redis (direct processing mode)
REDIS_URL=redis://localhost:6379
SKIP_REDIS=true

# Training Options
# Options: "gpu", "cpu", "auto"
# "auto" uses GPU if available, otherwise CPU
DEFAULT_TRAINING_MODE=auto

# COLMAP Settings
# Download COLMAP from: https://github.com/colmap/colmap/releases
# On Windows, point to the colmap.bat file
COLMAP_PATH=C:/Tools/colmap/colmap.bat
MAX_IMAGE_SIZE=1600
COLMAP_QUALITY=medium

# OpenSplat Settings
# Download OpenSplat from: https://github.com/pierotofy/OpenSplat
# Windows pre-built: http://sites.fastspring.com/masseranolabs/product/opensplatforwindows
OPENSPLAT_PATH=C:/Tools/opensplat/opensplat.exe

# Job Settings
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=7200000

# AI Enhancement: Depth Anything V2
# Requires Python 3.8+ with torch, transformers installed
# Install: pip install torch torchvision transformers pillow numpy tqdm
# Or: cd backend/scripts && pip install -r requirements.txt
DEPTH_ESTIMATION_ENABLED=false
# Model size: small (fast), base (balanced), large (best quality)
DEPTH_MODEL_SIZE=small
